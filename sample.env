# =============================================================================
# freeCodeCamp Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for services you will use.
# WARNING: Never commit .env files to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (Required)
# -----------------------------------------------------------------------------
MONGOHQ_URL='mongodb://localhost:27017/freecodecamp'

# -----------------------------------------------------------------------------
# Authentication Providers (Optional for local development)
# -----------------------------------------------------------------------------
# Facebook OAuth
FACEBOOK_ID=
FACEBOOK_SECRET=

# GitHub OAuth
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth
GOOGLE_ID=
GOOGLE_SECRET=

# LinkedIn OAuth
LINKEDIN_ID=
LINKEDIN_SECRET=

# Twitter OAuth
TWITTER_KEY=
TWITTER_SECRET=
TWITTER_TOKEN=
TWITTER_TOKEN_SECRET=

# -----------------------------------------------------------------------------
# Session Security (Required for production)
# -----------------------------------------------------------------------------
# Generate strong random strings for these values in production
SESSION_SECRET=
COOKIE_SECRET=

# -----------------------------------------------------------------------------
# Optional Services
# -----------------------------------------------------------------------------
# Peer integration
PEER=

# Opbeat monitoring (optional)
OPBEAT_ID=
OPBEAT_ORG_ID=
OPBEAT_SECRET=

# Slack webhook (optional)
SLACK_WEBHOOK=

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
DEBUG=true
IMAGE_BASE_URL='https://s3.amazonaws.com/freecodecamp/images/'
